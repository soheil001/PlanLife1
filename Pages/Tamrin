<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#1a0033">
<title>تمرینات مجازی - PlanLife</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
        height: 100%;
        font-family: 'Vazirmatn', sans-serif;
        overflow-x: hidden;
        color: white;
        background: #030303;
    }

    .stars { position: fixed; inset: 0; background: transparent; z-index: 1; pointer-events: none; }
    .stars::before, .stars::after {
        content: ''; position: absolute; inset: 0;
        background-image: radial-gradient(white 1px, transparent 1px);
        background-size: 80px 80px; opacity: 0.45; 
        animation: twinkle 10s infinite alternate, stars-move 20s linear infinite;
    }
    .stars::after { 
        background-size: 140px 140px; 
        opacity: 0.3; 
        animation: twinkle 16s infinite alternate, stars-move-diagonal 32s linear infinite;
    }
    @keyframes twinkle { 0% { opacity: 0.35; } 100% { opacity: 0.65; } }
    @keyframes stars-move { from { background-position: 0 0; } to { background-position: 22px -480px; } }
    @keyframes stars-move-diagonal { from { background-position: 0 0; } to { background-position: -35px -550px; } }

    header { 
        position: fixed; top: 0; left: 0; right: 0; height: 65px; 
        display: flex; align-items: center; padding: 0 20px; z-index: 100; 
        background: rgba(0,0,0,0.25); backdrop-filter: blur(10px); 
    }
    .hamburger { 
        font-size: 28px; cursor: pointer; width: 50px; height: 50px; 
        border-radius: 50%; background: rgba(255,255,255,0.1); 
        display: flex; align-items: center; justify-content: center;
        transition: all 0.2s ease;
    }

    .main-center { 
        position: relative; z-index: 5; min-height: 100vh; 
        padding: 85px 20px 80px; 
        display: flex; flex-direction: column; align-items: center; 
    }

    .title { 
        font-size: 38px; 
        font-weight: 900; 
        text-shadow: 0 0 30px rgba(160, 240, 255, 0.9); 
        margin-bottom: 40px; 
        color: white;
    }

    .exercise-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        width: 100%;
        max-width: 720px;
    }

    .exercise-card {
        background: rgba(255,255,255,0.11); 
        backdrop-filter: blur(16px); 
        border: 1px solid rgba(212, 175, 55, 0.55);
        border-radius: 28px; 
        padding: 32px 24px;
        text-align: center; 
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
        box-shadow: 0 10px 40px rgba(0,0,0,0.6), 0 0 25px rgba(212, 175, 55, 0.25);
        height: 320px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 20px;
    }

    .exercise-card:hover {
        transform: translateY(-12px) scale(1.03);
        box-shadow: 0 20px 50px rgba(0,0,0,0.7), 0 0 35px rgba(212, 175, 55, 0.4);
    }

    .exercise-card.morning { background: linear-gradient(135deg, rgba(255,215,0,0.08), rgba(255,255,255,0.05)); }
    .exercise-card.night   { background: linear-gradient(135deg, rgba(100,100,255,0.08), rgba(255,255,255,0.05)); }

    .exercise-card h2 {
        font-size: 24px;
        font-weight: 900;
        color: #d4af37;
        text-shadow: 0 0 15px rgba(212, 175, 55, 0.6);
    }

    .back-btn {
        position: absolute;
        top: 90px;
        left: 20px;
        font-size: 32px;
        cursor: pointer;
        z-index: 10;
    }

    /* فرم‌ها */
    .form-container {
        display: none;
        width: 100%;
        max-width: 720px;
        background: rgba(255,255,255,0.09);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(212, 175, 55, 0.5);
        border-radius: 28px;
        padding: 30px;
        margin-top: 20px;
    }

    .question {
        margin-bottom: 26px;
        padding-bottom: 18px;
        border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    }

    .question:last-child { border-bottom: none; margin-bottom: 0; }

    .question-label {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 10px;
        display: block;
        color: #d4af37;
    }

    textarea {
        width: 100%;
        min-height: 110px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(212, 175, 55, 0.4);
        border-radius: 16px;
        padding: 14px 18px;
        color: white;
        font-size: 16px;
        resize: vertical;
        font-family: inherit;
    }

    .small-input {
        width: 100%;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(212, 175, 55, 0.4);
        border-radius: 12px;
        padding: 12px 16px;
        color: white;
        font-size: 16px;
    }

    .btn {
        background: rgba(212,175,55,0.9);
        color: #111;
        border: none;
        padding: 14px 32px;
        font-size: 17px;
        font-weight: 800;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.3s;
        margin: 8px;
    }

    .btn:hover { background: #d4af37; transform: scale(1.05); }

    .history {
        margin-top: 40px;
        width: 100%;
        max-width: 720px;
    }

    .history h3 { color: #d4af37; margin-bottom: 15px; text-align: center; }

    .history-entry {
        background: rgba(255,255,255,0.08);
        border-radius: 20px;
        padding: 18px;
        margin-bottom: 18px;
        border: 1px solid rgba(212,175,55,0.3);
    }

    .tab-buttons {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        justify-content: center;
    }
</style>
</head>
<body>

<div class="stars"></div>

<header>
    <div class="hamburger" onclick="toggleMenu()">☰</div>
</header>

<div class="main-center">
    <div onclick="window.location.href='index.html'" class="back-btn">←</div>
    
    <div class="title">تمرینات مجازی 🧠</div>

    <!-- دو کارت اصلی -->
    <div class="exercise-grid" id="main-grid">
        <div class="exercise-card morning" onclick="openForm('morning')">
            <div style="font-size:58px;">🌅</div>
            <h2>تمرین صبح بیداری</h2>
            <p>شروع روز قدرتمند</p>
        </div>

        <div class="exercise-card night" onclick="openForm('night')">
            <div style="font-size:58px;">🌙</div>
            <h2>تمرین شب خواب</h2>
            <p>مرور روز و برنامه‌ریزی معنوی</p>
        </div>
    </div>

    <!-- فرم صبح -->
    <div id="morning-form" class="form-container">
        <h2 style="text-align:center; margin-bottom:30px; color:#d4af37;">تمرین صبح بیداری</h2>
        <!-- سوالات صبح (به‌روزرسانی شده) -->
        <div class="question"><label class="question-label">۱. بابت چه چیزی در این لحظه حالم خوب است؟</label><textarea id="mq1"></textarea></div>
        <div class="question"><label class="question-label">۲. بابت چه کسانی در این لحظه حالم خوب است؟</label><textarea id="mq2"></textarea></div>
        <div class="question"><label class="question-label">۳. میزان درصد تکرار باورهای قدرتمند امروزم چقدر بود؟</label><input type="number" id="mq3" class="small-input" placeholder="درصد (0-100)" min="0" max="100"></div>
        <div class="question"><label class="question-label">۴. کار مهمی که قرار بود امروز تمامش کنم تمام شد؟</label>
            <select id="mq4" class="small-input"><option value="">انتخاب کنید</option><option value="بله">بله</option><option value="خیر">خیر</option></select>
            <textarea id="mq4note" placeholder="توضیح کوتاه..." style="margin-top:8px; min-height:70px;"></textarea>
        </div>
        <div class="question"><label class="question-label">۵. چه کارهایی برای رسیدن به اهدافم انجام دادم امروز؟</label><textarea id="mq5"></textarea></div>
        
        <div style="text-align:center; margin:30px 0 10px;">
            <button class="btn" onclick="saveAnswers('morning')">ذخیره تمرین صبح</button>
            <button class="btn" onclick="closeForm()" style="background:rgba(255,255,255,0.2);">بازگشت</button>
        </div>
    </div>

    <!-- فرم شب -->
    <div id="night-form" class="form-container">
        <h2 style="text-align:center; margin-bottom:30px; color:#d4af37;">تمرین شب موقع خواب</h2>
        <div class="question"><label class="question-label">۱. بابت چه چیزی در این لحظه حالم خوب است؟</label><textarea id="nq1"></textarea></div>
        <div class="question"><label class="question-label">۲. بابت چه کسانی در این لحظه حالم خوب است؟</label><textarea id="nq2"></textarea></div>
        <div class="question"><label class="question-label">۳. میزان درصد تکرار باورهای قدرتمند امروزم چقدر بود؟</label><input type="number" id="nq3" class="small-input" placeholder="درصد (0-100)" min="0" max="100"></div>
        <div class="question"><label class="question-label">۴. کار مهمی که قرار بود امروز تمامش کنم تمام شد؟</label>
            <select id="nq4" class="small-input"><option value="">انتخاب کنید</option><option value="بله">بله</option><option value="خیر">خیر</option></select>
            <textarea id="nq4note" placeholder="توضیح کوتاه..." style="margin-top:8px; min-height:70px;"></textarea>
        </div>
        <div class="question"><label class="question-label">۵. چه کارهایی برای رسیدن به اهدافم انجام دادم امروز؟</label><textarea id="nq5"></textarea></div>
        <div class="question"><label class="question-label">۶. اتفاقاتی که از خداوند می‌خواستم چنتاش محقق شد؟</label><textarea id="nq6"></textarea></div>
        <div class="question"><label class="question-label">۷. امروز از ۱ تا ۱۰ چه نمره‌ای به بی‌فکر بودنم می‌دهم؟</label><input type="number" id="nq7" class="small-input" placeholder="۱ تا ۱۰" min="1" max="10"></div>
        <div class="question"><label class="question-label">۸. چه اتفاقات جالبی امروز برای من رخ داد؟</label><textarea id="nq8" style="min-height:140px;"></textarea></div>
        <div class="question"><label class="question-label">۹. الان می‌خوام در مورد چه موضوعی تجسم انجام بدم؟</label><textarea id="nq9"></textarea></div>
        <div class="question"><label class="question-label">۱۰. امشب چقدر می‌خوام مدیتیشن کنم؟ (چند دقیقه)</label><input type="number" id="nq10" class="small-input" placeholder="دقیقه"></div>

        <div style="text-align:center; margin:30px 0 10px;">
            <button class="btn" onclick="saveAnswers('night')">ذخیره تمرین شب</button>
            <button class="btn" onclick="closeForm()" style="background:rgba(255,255,255,0.2);">بازگشت</button>
        </div>
    </div>

    <!-- تاریخچه -->
    <div class="history" id="history-section">
        <div class="tab-buttons">
            <button class="btn" onclick="showHistory('all')" style="padding:10px 20px;font-size:15px;">همه</button>
            <button class="btn" onclick="showHistory('morning')" style="padding:10px 20px;font-size:15px;">صبح</button>
            <button class="btn" onclick="showHistory('night')" style="padding:10px 20px;font-size:15px;">شب</button>
        </div>
        <h3>تاریخچه تمرینات</h3>
        <div id="history-list"></div>
        
        <div style="text-align:center; margin-top:25px;">
            <button class="btn" onclick="downloadAllHistory()">دانلود همه به صورت متن</button>
            <button class="btn" onclick="window.print()" style="background:rgba(255,255,255,0.2);">چاپ / ذخیره PDF</button>
        </div>
    </div>
</div>

<script>
// باز کردن فرم
function openForm(type) {
    document.getElementById('main-grid').style.display = 'none';
    document.getElementById('history-section').style.display = 'none';
    
    if (type === 'morning') {
        document.getElementById('morning-form').style.display = 'block';
    } else {
        document.getElementById('night-form').style.display = 'block';
    }
}

function closeForm() {
    document.getElementById('morning-form').style.display = 'none';
    document.getElementById('night-form').style.display = 'none';
    document.getElementById('main-grid').style.display = 'grid';
    document.getElementById('history-section').style.display = 'block';
    loadHistory();
}

// ذخیره پاسخ‌ها
function saveAnswers(type) {
    const prefix = type === 'morning' ? 'm' : 'n';
    const data = {
        type: type,
        date: new Date().toLocaleDateString('fa-IR'),
        timestamp: Date.now(),
        q1: document.getElementById(prefix + 'q1').value.trim(),
        q2: document.getElementById(prefix + 'q2').value.trim(),
        q3: document.getElementById(prefix + 'q3').value.trim(),
        q4: document.getElementById(prefix + 'q4').value,
        q4note: document.getElementById(prefix + 'q4note').value.trim(),
        q5: document.getElementById(prefix + 'q5').value.trim(),
    };

    if (type === 'night') {
        data.q6 = document.getElementById('nq6').value.trim();
        data.q7 = document.getElementById('nq7').value.trim();
        data.q8 = document.getElementById('nq8').value.trim();
        data.q9 = document.getElementById('nq9').value.trim();
        data.q10 = document.getElementById('nq10').value.trim();
    }

    let history = JSON.parse(localStorage.getItem('exercisesHistory')) || [];
    history.unshift(data);
    localStorage.setItem('exercisesHistory', JSON.stringify(history));

    alert(`✅ تمرین ${type === 'morning' ? 'صبح' : 'شب'} با موفقیت ذخیره شد!`);
    closeForm();
}

// بارگذاری تاریخچه
function loadHistory(filter = 'all') {
    const list = document.getElementById('history-list');
    let history = JSON.parse(localStorage.getItem('exercisesHistory')) || [];

    if (filter !== 'all') {
        history = history.filter(item => item.type === filter);
    }

    if (history.length === 0) {
        list.innerHTML = `<p style="text-align:center; opacity:0.7; padding:20px;">هنوز تمرینی ثبت نشده است.</p>`;
        return;
    }

    let html = '';
    history.forEach(entry => {
        const isMorning = entry.type === 'morning';
        html += `
            <div class="history-entry">
                <h4>${entry.date} — ${isMorning ? '🌅 صبح' : '🌙 شب'}</h4>
                <p><strong>۱. حال خوب:</strong> ${entry.q1 || '—'}</p>
                <p><strong>۲. اشخاص:</strong> ${entry.q2 || '—'}</p>
                <p><strong>۳. درصد باورها:</strong> ${entry.q3 || '—'}%</p>
                <p><strong>۴. کار مهم:</strong> ${entry.q4 || '—'} ${entry.q4note ? `(${entry.q4note})` : ''}</p>
                <p><strong>۵. اقدامات:</strong> ${entry.q5 || '—'}</p>
                ${!isMorning ? `
                <p><strong>۶. محقق شده:</strong> ${entry.q6 || '—'}</p>
                <p><strong>۷. نمره بی‌فکری:</strong> ${entry.q7 || '—'}/۱۰</p>
                <p><strong>۸. اتفاقات جالب:</strong> ${entry.q8 || '—'}</p>
                <p><strong>۹. تجسم:</strong> ${entry.q9 || '—'}</p>
                <p><strong>۱۰. مدیتیشن:</strong> ${entry.q10 || '—'} دقیقه</p>` : ''}
            </div>
        `;
    });
    list.innerHTML = html;
}

function showHistory(filter) {
    loadHistory(filter);
}

// دانلود همه به صورت متن
function downloadAllHistory() {
    let history = JSON.parse(localStorage.getItem('exercisesHistory')) || [];
    if (history.length === 0) {
        alert("هنوز هیچ تمرینی ذخیره نشده!");
        return;
    }

    let text = "📖 تاریخچه کامل تمرینات مجازی PlanLife\n\n";
    
    history.forEach((entry, i) => {
        const type = entry.type === 'morning' ? '🌅 تمرین صبح' : '🌙 تمرین شب';
        text += `=== ${entry.date} — ${type} ===\n\n`;
        text += `۱. حال خوب: ${entry.q1 || '—'}\n`;
        text += `۲. اشخاص: ${entry.q2 || '—'}\n`;
        text += `۳. درصد باورها: ${entry.q3 || '—'}%\n`;
        text += `۴. کار مهم: ${entry.q4 || '—'} ${entry.q4note ? `(${entry.q4note})` : ''}\n`;
        text += `۵. اقدامات: ${entry.q5 || '—'}\n`;
        if (entry.type === 'night') {
            text += `۶. محقق شده: ${entry.q6 || '—'}\n`;
            text += `۷. نمره بی‌فکری: ${entry.q7 || '—'}/۱۰\n`;
            text += `۸. اتفاقات جالب: ${entry.q8 || '—'}\n`;
            text += `۹. تجسم: ${entry.q9 || '—'}\n`;
            text += `۱۰. مدیتیشن: ${entry.q10 || '—'} دقیقه\n`;
        }
        text += "\n────────────────────────────\n\n";
    });

    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `PlanLife_تمرینات_مجازی_${new Date().toLocaleDateString('fa-IR')}.txt`;
    a.click();
    URL.revokeObjectURL(url);
}

// منو
function toggleMenu() {
    alert('منوی کامل به زودی اضافه می‌شود ✨\nبرای بازگشت از دکمه ← استفاده کنید.');
}

// بارگذاری اولیه
window.onload = () => {
    loadHistory('all');
};
</script>
</body>
</html>
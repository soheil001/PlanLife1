<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#1a0033">
<title>نظرات دوستان - PlanLife</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;700;900&display=swap" rel="stylesheet">
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { min-height: 100%; font-family: 'Vazirmatn', sans-serif; overflow-x: hidden; color: white; background: #030303; }
    .stars { position: fixed; inset: 0; background: transparent; z-index: 0; pointer-events: none; }
    .stars::before, .stars::after { content: ''; position: absolute; inset: 0; background-image: radial-gradient(white 1px, transparent 1px); background-size: 80px 80px; opacity: 0.45; }
    .stars::after { background-size: 140px 140px; opacity: 0.3; }

    header {
        position: sticky; top: 0; z-index: 50;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(15px);
        border-bottom: 1px solid rgba(212,175,55,0.2);
        padding: 18px 20px;
        display: flex; align-items: center; justify-content: center;
    }
    .header-title {
        font-family: 'Georgia','Times New Roman',serif;
        font-size: 20px; font-weight: 700; letter-spacing: 1px;
        background: linear-gradient(135deg, #f5d77a 0%, #d4af37 45%, #b8860b 70%, #f5d77a 100%);
        -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
        text-shadow: 0 0 20px rgba(212,175,55,0.35);
    }
    .back-btn {
        position: absolute; right: 18px; top: 50%; transform: translateY(-50%);
        width: 40px; height: 40px; border-radius: 50%;
        background: rgba(255,255,255,0.08); border: 1px solid rgba(212,175,55,0.3);
        backdrop-filter: blur(10px);
        display: flex; align-items: center; justify-content: center;
        color: #f5d77a; text-decoration: none;
    }
    .back-btn:active { transform: translateY(-50%) scale(0.9); background: rgba(255,255,255,0.16); }
    .back-btn svg { width: 20px; height: 20px; }

    /* ===== نوار دعوت به اشتراک‌گذاری ===== */
    .share-banner {
        position: relative; z-index: 2;
        margin: 16px 14px 6px;
        padding: 18px 18px 16px;
        border-radius: 18px;
        background: linear-gradient(155deg, rgba(255,255,255,0.09), rgba(255,255,255,0.03));
        border: 1px solid rgba(212,175,55,0.35);
        backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.08);
        max-width: 480px;
        margin-left: auto; margin-right: auto;
    }
    .share-banner-title {
        font-size: 14.5px; font-weight: 800; line-height: 1.4;
        text-align: center;
        background: linear-gradient(135deg, #f5d77a 0%, #d4af37 50%, #f5d77a 100%);
        -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
        margin-bottom: 6px;
    }
    .share-banner-text {
        font-size: 12.5px; line-height: 1.9; color: rgba(255,255,255,0.82);
        text-align: center;
    }
    .share-banner-socials {
        display: flex; align-items: center; justify-content: center;
        gap: 14px; margin-top: 14px;
        direction: ltr;
    }
    .share-social-item {
        display: flex; flex-direction: column; align-items: center; gap: 5px;
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
    }
    .share-social-icon {
        width: 44px; height: 44px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(212,175,55,0.35);
        transition: transform 0.15s ease, background 0.15s ease;
    }
    .share-social-item:active .share-social-icon { transform: scale(0.9); background: rgba(255,255,255,0.14); }
    .share-social-icon svg { width: 21px; height: 21px; }
    .icon-telegram svg { color: #5fb6e8; }
    .icon-instagram svg { color: #e28a4f; }
    .icon-bale svg { color: #f0c869; }
    .share-social-label {
        font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.65);
        direction: rtl;
    }

    /* ===== باکس شیشه‌ای «در حال آماده‌سازی» ===== */
    .coming-soon-wrap {
        position: relative; z-index: 2;
        max-width: 480px;
        margin: 22px auto 60px;
        padding: 0 14px;
    }
    .coming-soon-box {
        border-radius: 20px;
        padding: 34px 22px 30px;
        text-align: center;
        background: linear-gradient(155deg, rgba(255,255,255,0.1), rgba(255,255,255,0.03));
        border: 1px solid rgba(212,175,55,0.35);
        backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 10px 34px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.08);
        position: relative;
        overflow: hidden;
    }
    .coming-soon-box::before {
        content: '';
        position: absolute; top: 0; left: -100%;
        width: 100%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
        animation: glass-shine 3.5s ease-in-out infinite;
    }
    @keyframes glass-shine { 0% { left: -100%; } 50% { left: 100%; } 100% { left: 100%; } }

    .coming-soon-icon {
        width: 66px; height: 66px; margin: 0 auto 18px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: rgba(212,175,55,0.12);
        border: 1px solid rgba(212,175,55,0.4);
    }
    .coming-soon-icon svg {
        width: 30px; height: 30px;
        color: #f5d77a;
        animation: spin-slow 6s linear infinite;
        transform-origin: center;
    }
    @keyframes spin-slow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    .coming-soon-title {
        font-size: 16px; font-weight: 800; line-height: 1.6;
        background: linear-gradient(135deg, #f5d77a 0%, #d4af37 50%, #f5d77a 100%);
        -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
        margin-bottom: 10px;
        position: relative; z-index: 1;
    }
    .coming-soon-text {
        font-size: 13px; line-height: 2; color: rgba(255,255,255,0.75);
        position: relative; z-index: 1;
    }
</style>
</head>
<body>

<div class="stars"></div>

<header>
    <a href="https://planlife.ir/Pages/Doreha/index.html" class="back-btn" aria-label="بازگشت به دوره‌ها">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
    </a>
    <div class="header-title">نظرات شما</div>
</header>

<!-- ===== نوار دعوت به اشتراک‌گذاری تجربه ===== -->
<div class="share-banner">
    <div class="share-banner-title">تجربه‌ی شما، امید فرداهای یک نفر دیگه‌ست ✨</div>
    <div class="share-banner-text">
        نتیجه‌ها، تغییرات و حال خوبی که این مسیر برای شما ساخته رو با ما و بقیه‌ی دوستان به اشتراک بذارید؛
        همین یک قدم کوچیک شما می‌تونه امید، ایمان و انگیزه‌ای بشه برای کسایی که تازه می‌خوان این مسیر رو شروع کنن.
    </div>
    <div class="share-banner-socials">
        <a class="share-social-item" href="https://t.me/planlifeir" target="_blank" rel="noopener">
            <div class="share-social-icon icon-telegram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13"/><path d="M22 2l-7 20-4-9-9-4 20-7z"/></svg>
            </div>
            <div class="share-social-label">تلگرام</div>
        </a>
        <a class="share-social-item" href="https://instagram.com/planlife.ir" target="_blank" rel="noopener">
            <div class="share-social-icon icon-instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none"/></svg>
            </div>
            <div class="share-social-label">اینستاگرام</div>
        </a>
        <a class="share-social-item" href="https://ble.ir/planlifeir" target="_blank" rel="noopener">
            <div class="share-social-icon icon-bale">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <div class="share-social-label">بله</div>
        </a>
    </div>
</div>

<!-- ===== باکس شیشه‌ای در حال آماده‌سازی ===== -->
<div class="coming-soon-wrap">
    <div class="coming-soon-box">
        <div class="coming-soon-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 7v5l3 3"/>
            </svg>
        </div>
        <div class="coming-soon-title">در حال آماده‌سازی</div>
        <div class="coming-soon-text">
            صفحه‌ی نظرات ثبت‌شده‌ی شما در حال آماده‌سازی است<br>
            و به زودی اضافه خواهد شد.
        </div>
    </div>
</div>

</body>
</html>

      <strong>سایت cllo.ir (سیلو)</strong> صرفاً یک بستر اتصال بین اجاره‌دهنده و اجاره‌گیرنده است.<br><br>
      این سایت <strong>هیچ‌گونه مسئولیتی</strong> در قبال وضعیت، کیفیت، صحت اطلاعات، خسارت، مفقودی، یا هرگونه اختلاف ناشی از وسیله اجاره‌شده <strong>ندارد</strong>.<br><br>
      قرارداد اجاره مستقیماً میان دو طرف بسته می‌شود.
    </div>
    <label class="modal-check">
      <input type="checkbox" id="callAgree" onchange="toggleCallBtn()">
      <span>موارد فوق را خواندم و می‌دانم که <strong>cllo.ir</strong> مسئولیتی در قبال این اجاره ندارد.</span>
    </label>
    <div class="modal-actions">
      <button class="btn-modal-cancel" onclick="closeModal('callModal')">انصراف</button>
      <button class="btn-modal-ok" id="callOkBtn" onclick="doCall()">نمایش شماره تماس</button>
    </div>
    <div class="phone-reveal-box" id="phoneReveal">
      <div class="phone-number" id="phoneNumber"></div>
      <a class="btn-call-now" id="callLink" href="#">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        تماس مستقیم
      </a>
    </div>
  </div>
</div>

<!-- MODAL: LOGIN -->
<div class="modal-overlay" id="loginModal">
  <div class="login-box">
    <div class="login-logo"><img src="https://res.cloudinary.com/dshielkdt/image/upload/q_auto/f_auto/v1781018687/_ir_puvab6.png" alt="سیلو"></div>
    <div class="login-subtitle">بازار اجاره آنلاین ایران</div>
    <div class="login-tabs">
      <button class="login-tab active" id="tabLogin" onclick="switchTab('login')">ورود</button>
      <button class="login-tab" id="tabRegister" onclick="switchTab('register')">ثبت‌نام</button>
    </div>
    <div id="formLogin">
      <div class="login-input-group">
        <label>شماره موبایل</label>
        <input type="tel" id="loginPhone" placeholder="09XXXXXXXXX">
      </div>
      <div class="login-input-group">
        <label>رمز عبور</label>
        <input type="password" id="loginPass" placeholder="رمز عبور">
      </div>
      <div class="login-err" id="loginErr">شماره یا رمز اشتباه است</div>
      <button class="btn-login-submit" onclick="doLogin()">ورود به حساب</button>
    </div>
    <div id="formRegister" style="display:none;">
      <div class="login-input-group">
        <label>نام و نام خانوادگی</label>
        <input type="text" id="regName" placeholder="نام کامل شما">
      </div>
      <div class="login-input-group">
        <label>شماره موبایل</label>
        <input type="tel" id="regPhone" placeholder="09XXXXXXXXX">
      </div>
      <div class="login-input-group">
        <label>رمز عبور</label>
        <input type="password" id="regPass" placeholder="حداقل ۶ کاراکتر">
      </div>
      <div class="login-err" id="regErr"></div>
      <button class="btn-login-submit" onclick="doRegister()">ایجاد حساب</button>
    </div>
  </div>
</div>

<script>
const EXPIRY_DAYS = 14;
let allAds = [], currentCat = 'all', currentSearch = '', carouselIndex = 0, carouselTotal = 0, currentAdPhone = '';
const catNames = {tools:'ابزار و تجهیزات',home:'خانه و آشپزخانه',event:'رویداد و مجلس',sport:'ورزش و تناسب اندام',tech:'کالای دیجیتال',music:'آلات موسیقی',book:'کتاب و مجله',personal:'وسایل شخصی',ticket:'بلیط',collect:'کلکسیون و سرگرمی'};

/* ══ AUTH ══ */
function getUsers(){try{return JSON.parse(localStorage.getItem('siloUsers')||'[]');}catch{return[];}}
function saveUsers(u){localStorage.setItem('siloUsers',JSON.stringify(u));}
function getCurrentUser(){try{return JSON.parse(localStorage.getItem('siloCurrentUser')||'null');}catch{return null;}}
function setCurrentUser(u){localStorage.setItem('siloCurrentUser',JSON.stringify(u));}
function clearCurrentUser(){localStorage.removeItem('siloCurrentUser');}

function updateHeaderAuth(){
  const u = getCurrentUser();
  if(u){
    document.getElementById('headerGuest').style.display = 'none';
    document.getElementById('headerUser').style.display  = 'flex';
    document.getElementById('userAvatarBtn').textContent  = u.name.charAt(0);
    document.getElementById('ddName').textContent         = u.name;
  } else {
    document.getElementById('headerGuest').style.display = 'flex';
    document.getElementById('headerUser').style.display  = 'none';
  }
}

function openLoginModal(){
  document.getElementById('loginPhone').value = '';
  document.getElementById('loginPass').value  = '';
  document.getElementById('loginErr').classList.remove('show');
  openModal('loginModal');
}

function switchTab(t){
  document.getElementById('formLogin').style.display    = t === 'login'    ? 'block' : 'none';
  document.getElementById('formRegister').style.display = t === 'register' ? 'block' : 'none';
  document.getElementById('tabLogin').classList.toggle('active',    t === 'login');
  document.getElementById('tabRegister').classList.toggle('active', t === 'register');
}

function doLogin(){
  const phone = document.getElementById('loginPhone').value.trim();
  const pass  = document.getElementById('loginPass').value;
  const users = getUsers();
  const u     = users.find(x => x.phone === phone && x.pass === pass);
  if(!u){ document.getElementById('loginErr').classList.add('show'); return; }
  setCurrentUser({name:u.name, phone:u.phone});
  closeModal('loginModal');
  updateHeaderAuth();
  if(window._postAfterLogin){ window._postAfterLogin = false; window.location.href = 'post.html'; }
}

function doRegister(){
  const name  = document.getElementById('regName').value.trim();
  const phone = document.getElementById('regPhone').value.trim();
  const pass  = document.getElementById('regPass').value;
  const err   = document.getElementById('regErr');
  if(!name || !phone || !pass){ err.textContent = 'همه فیلدها الزامی است'; err.classList.add('show'); return; }
  if(pass.length < 6){ err.textContent = 'رمز عبور باید حداقل ۶ کاراکتر باشد'; err.classList.add('show'); return; }
  const users = getUsers();
  if(users.find(x => x.phone === phone)){ err.textContent = 'این شماره قبلاً ثبت شده است'; err.classList.add('show'); return; }
  users.push({name, phone, pass, registeredAt: Date.now()});
  saveUsers(users);
  setCurrentUser({name, phone});
  closeModal('loginModal');
  updateHeaderAuth();
  if(window._postAfterLogin){ window._postAfterLogin = false; window.location.href = 'post.html'; }
}

function doLogout(){
  clearCurrentUser();
  updateHeaderAuth();
  document.getElementById('userDropdown').classList.remove('open');
}

function toggleUserMenu(){ document.getElementById('userDropdown').classList.toggle('open'); }

document.addEventListener('click', e => {
  const wrap = document.getElementById('headerUser');
  if(wrap && !wrap.contains(e.target)) document.getElementById('userDropdown').classList.remove('open');
});

function handlePostClick(){
  if(getCurrentUser()){ window.location.href = 'post.html'; }
  else { window._postAfterLogin = true; openLoginModal(); }
}

/* ══ ADS — فقط آگهی‌های تأیید شده از siloAds نمایش داده می‌شوند ══ */
function isExpired(ad){
  return ad.postTime && (Date.now() - ad.postTime) > (EXPIRY_DAYS * 86400000);
}

function loadAds(){
  try{ allAds = JSON.parse(localStorage.getItem('siloAds') || '[]'); } catch{ allAds = []; }
  /* فقط آگهی‌های تأیید شده (status==='approved') یا آگهی‌هایی که status ندارند (legacy) */
  allAds = allAds.filter(a => {
    if(isExpired(a)) return false;
    /* اگر status موجود باشد، فقط approved نشان بده */
    if(a.status && a.status !== 'approved') return false;
    return true;
  });
}

function renderAds(ads){
  document.getElementById('adCount').textContent = ads.length;
  if(!ads.length){
    document.getElementById('adsGrid').innerHTML = `
      <div class="empty-ads">
        <div class="ea-icon">🔍</div>
        <p>آگهی‌ای یافت نشد</p>
      </div>`;
    return;
  }
  document.getElementById('adsGrid').innerHTML = ads.map(ad => `
    <div class="ad-card" onclick="showDetail(${ad.id})">
      <div class="ad-img-wrap">
        ${ad.badge ? `<div class="ad-badge">${ad.badge}</div>` : ''}
        ${ad.images && ad.images[0]
          ? `<img src="${ad.images[0]}" alt="${ad.title}">`
          : '<div style="color:var(--text-dim);font-size:28px;">📦</div>'}
      </div>
      <div class="ad-body">
        <div class="ad-title">${ad.title}</div>
        <div class="ad-location"><span class="ad-location-dot"></span>${ad.city}</div>
        <div class="ad-footer">
          <div class="ad-price">${Number(ad.price).toLocaleString('fa-IR')}<small>تومان / روز</small></div>
          <div class="ad-date">${ad.date}</div>
        </div>
      </div>
    </div>`).join('');
}

function getFiltered(){
  const cityFilter = document.querySelector('.city-select')?.value || '';
  return allAds.filter(a => {
    const catOk  = currentCat === 'all' || a.cat === currentCat;
    const cityOk = !cityFilter || a.city === cityFilter;
    const srch   = !currentSearch || a.title.includes(currentSearch) || a.city.includes(currentSearch) || (a.desc||'').includes(currentSearch);
    return catOk && cityOk && srch;
  });
}

function filterAds(){ currentSearch = document.getElementById('headerSearch').value; renderAds(getFiltered()); }

function toggleGroup(el, key){
  const list = document.getElementById('grp-' + key);
  list.classList.toggle('open');
  el.classList.toggle('open');
}

function filterCatGroup(el, cat){
  currentCat = cat;
  document.querySelectorAll('.cat-group-header').forEach(e => e.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.cat-sub-item').forEach(e => e.classList.remove('active'));
  renderAds(getFiltered());
}

function filterSub(parentCat, el){
  currentCat = parentCat;
  document.querySelectorAll('.cat-sub-item,.cat-group-header').forEach(e => e.classList.remove('active'));
  el.classList.add('active');
  renderAds(getFiltered());
}

function filterCatBtn(el, cat){
  currentCat = cat;
  document.querySelectorAll('.cat-btn').forEach(e => e.classList.remove('active'));
  el.classList.add('active');
  renderAds(getFiltered());
}

function applyFilter(){
  const mn = parseInt(document.getElementById('priceMin').value) || 0;
  const mx = parseInt(document.getElementById('priceMax').value) || Infinity;
  renderAds(getFiltered().filter(a => a.price >= mn && a.price <= mx));
}

function sortAds(v){
  let ads = getFiltered();
  if(v === 'cheapest')  ads.sort((a,b) => a.price - b.price);
  else if(v === 'expensive') ads.sort((a,b) => b.price - a.price);
  renderAds(ads);
}

/* ══ DETAIL ══ */
function showDetail(id){
  const ad = allAds.find(a => a.id === id);
  if(!ad) return;
  currentAdPhone = ad.phone || '';
  document.getElementById('detailTitle').textContent = ad.title;
  document.getElementById('detailCity').textContent  = ad.city;
  document.getElementById('detailCat').textContent   = catNames[ad.cat] || ad.cat;
  document.getElementById('detailDate').textContent  = ad.date;
  document.getElementById('detailDesc').textContent  = ad.desc || '';
  document.getElementById('detailPrice').textContent = Number(ad.price).toLocaleString('fa-IR');
  document.getElementById('detailOwner').textContent = ad.owner;
  const imgs = (ad.images && ad.images.length) ? ad.images : [];
  carouselTotal = imgs.length; carouselIndex = 0;
  const track = document.getElementById('carouselTrack');
  if(imgs.length){
    track.innerHTML = imgs.map(src => `<div class="carousel-slide" style="flex-shrink:0;width:100%;"><img src="${src}" alt="" style="width:100%;height:300px;object-fit:cover;display:block;"></div>`).join('');
  } else {
    track.innerHTML = `<div class="carousel-slide" style="height:300px;display:flex;align-items:center;justify-content:center;font-size:52px;">📦</div>`;
  }
  const dotsEl = document.getElementById('carouselDots');
  dotsEl.innerHTML = imgs.length > 1 ? imgs.map((_,i) => `<div class="dot${i===0?' active':''}" onclick="goSlide(${i})"></div>`).join('') : '';
  document.querySelectorAll('.carousel-btn').forEach(b => b.style.display = imgs.length > 1 ? 'flex' : 'none');
  showPage('detail');
}

/* ══ CAROUSEL ══ */
function goSlide(idx){
  if(carouselTotal < 2) return;
  carouselIndex = idx;
  document.getElementById('carouselTrack').style.transform = `translateX(${idx * 100}%)`;
  document.querySelectorAll('.dot').forEach((d,i) => d.classList.toggle('active', i === idx));
}
function carouselMove(dir){ goSlide((carouselIndex + dir + carouselTotal) % carouselTotal); }

/* ══ MODALS ══ */
function openModal(id){ document.getElementById(id).classList.add('open'); }
function closeModal(id){ document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(m => m.addEventListener('click', e => { if(e.target === m) m.classList.remove('open'); }));

function openCallModal(){
  document.getElementById('callAgree').checked = false;
  document.getElementById('callOkBtn').classList.remove('ready');
  document.getElementById('phoneReveal').classList.remove('show');
  document.getElementById('callOkBtn').style.display = '';
  document.querySelector('#callModal .btn-modal-cancel').textContent = 'انصراف';
  openModal('callModal');
}
function toggleCallBtn(){ document.getElementById('callOkBtn').classList.toggle('ready', document.getElementById('callAgree').checked); }
function doCall(){
  const phone = currentAdPhone || 'شماره ثبت نشده';
  document.getElementById('phoneNumber').textContent = phone;
  document.getElementById('callLink').href = 'tel:' + phone.replace(/-/g,'');
  document.getElementById('phoneReveal').classList.add('show');
  document.getElementById('callOkBtn').style.display = 'none';
  document.querySelector('#callModal .btn-modal-cancel').textContent = 'بستن';
}

function showPage(name){
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + name).classList.add('active');
  window.scrollTo(0, 0);
}

window.addEventListener('load', () => {
  loadAds();
  renderAds(allAds);
  updateHeaderAuth();
});
</script>
</body>
</html>

<script>
const EXPIRY_DAYS = 14;

function isAdExpired(ad) {
  const postTime = ad.postTime || Date.now();
  const expiryTime = postTime + (EXPIRY_DAYS * 24 * 60 * 60 * 1000);
  return Date.now() > expiryTime;
}

function removeExpiredAds() {
  allAds = allAds.filter(ad => !isAdExpired(ad));
  saveAdsToStorage();
}

function saveAdsToStorage() {
  localStorage.setItem('siloAds', JSON.stringify(allAds));
}

function loadAdsFromStorage() {
  const stored = localStorage.getItem('siloAds');
  if (stored) {
    allAds = JSON.parse(stored);
    removeExpiredAds();
  }
}

let allAds = [];

const catNames={tools:'ابزار و تجهیزات',home:'خانه و آشپزخانه',event:'رویداد و مجلس',sport:'ورزش و تناسب اندام',tech:'کالای دیجیتال',music:'آلات موسیقی',book:'کتاب و مجله',personal:'وسایل شخصی',ticket:'بلیط',collect:'کلکسیون و سرگرمی'};

let currentCat='all',currentSearch='',carouselIndex=0,carouselSlides=0;

function renderAds(ads){
  document.getElementById('adCount').textContent=ads.length;
  document.getElementById('adsGrid').innerHTML=ads.map(ad=>{
    const expired=isAdExpired(ad);
    const hasImage = ad.images && ad.images.length > 0;
    const coverImage = hasImage ? ad.images[0] : null;
    return `
    <div class="ad-card${expired?' expired':''}" onclick="showDetail(${ad.id})">
      <div class="ad-img-wrap">
        ${ad.badge?`<div class="ad-badge">${ad.badge}</div>`:''}
        ${coverImage ? `<img src="${coverImage}" alt="${ad.title}">` : '<div class="ad-img-placeholder"><div class="ad-img-icon" style="color:#b0bec5;">📦</div></div>'}
      </div>
      <div class="ad-body">
        <div class="ad-title">${ad.title}</div>
        <div class="ad-location"><span class="ad-location-dot"></span>${ad.city}</div>
        <div class="ad-footer">
          <div class="ad-price">${ad.price.toLocaleString('fa-IR')}<small>تومان / روز</small></div>
          <div class="ad-date">${ad.date}</div>
        </div>
      </div>
    </div>`
  }).join('');
}

function getFiltered(){
  return allAds.filter(a=>{
    const catOk=currentCat==='all'||a.cat===currentCat;
    const srch=!currentSearch||a.title.includes(currentSearch)||a.city.includes(currentSearch)||a.desc.includes(currentSearch);
    return catOk&&srch;
  });
}

function filterAds(){currentSearch=document.getElementById('headerSearch').value;renderAds(getFiltered());}

function toggleGroup(headerEl,groupKey){
  const listEl=document.getElementById('grp-'+groupKey);
  const isOpen=listEl.classList.contains('open');
  listEl.classList.toggle('open',!isOpen);
  headerEl.classList.toggle('open',!isOpen);
}

function filterCatGroup(el,cat){
  currentCat=cat;
  document.querySelectorAll('.cat-group-header').forEach(e=>e.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.cat-sub-item').forEach(e=>e.classList.remove('active'));
  renderAds(getFiltered());
}
function filterSub(parentCat,el){
  currentCat=parentCat;
  document.querySelectorAll('.cat-sub-item').forEach(e=>e.classList.remove('active'));
  document.querySelectorAll('.cat-group-header').forEach(e=>e.classList.remove('active'));
  el.classList.add('active');
  renderAds(getFiltered());
}

function filterCatBtn(el,cat){
  currentCat=cat;
  document.querySelectorAll('.cat-btn').forEach(e=>e.classList.remove('active'));
  el.classList.add('active');
  renderAds(getFiltered());
}

function applyFilter(){
  const min=parseInt(document.getElementById('priceMin').value)||0;
  const max=parseInt(document.getElementById('priceMax').value)||Infinity;
  renderAds(getFiltered().filter(a=>a.price>=min&&a.price<=max));
}
function sortAds(val){
  let ads=getFiltered();
  if(val==='cheapest')ads.sort((a,b)=>a.price-b.price);
  else if(val==='expensive')ads.sort((a,b)=>b.price-a.price);
  renderAds(ads);
}

function showDetail(id){
  const ad=allAds.find(a=>a.id===id);if(!ad)return;
  document.getElementById('detailTitle').textContent=ad.title;
  document.getElementById('detailCity').textContent=ad.city;
  document.getElementById('detailCat').textContent=catNames[ad.cat]||ad.cat;
  document.getElementById('detailDate').textContent=ad.date;
  document.getElementById('detailDesc').textContent=ad.desc;
  document.getElementById('detailPrice').textContent=ad.price.toLocaleString('fa-IR');
  document.getElementById('detailOwner').textContent=ad.owner;
  carouselIndex=0;carouselSlides=(ad.images?.length||0);
  let slides='';
  if(ad.images){
    ad.images.forEach(img=>slides+=`<div class="carousel-slide with-image"><img src="${img}" alt=""></div>`);
  }
  document.getElementById('carouselTrack').innerHTML=slides;
  const dotCount=Math.max(1,(ad.images?.length||0));
  document.getElementById('carouselDots').innerHTML=Array(dotCount).fill(0).map((_,i)=>`<div class="dot${i===0?' active':''}" onclick="goSlide(${i})"></div>`).join('');
  showPage('detail');
}

function carouselMove(dir){carouselIndex=(carouselIndex+dir+carouselSlides)%carouselSlides;goSlide(carouselIndex);}
function goSlide(idx){
  carouselIndex=idx;
  const track=document.getElementById('carouselTrack');
  track.scrollTo({left:idx*track.offsetWidth,behavior:'smooth'});
  document.querySelectorAll('.dot').forEach((d,i)=>d.classList.toggle('active',i===idx));
}

function showPage(name){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('page-'+name).classList.add('active');
  window.scrollTo(0,0);
}

function openModal(id){document.getElementById(id).classList.add('open');}
function closeModal(id){document.getElementById(id).classList.remove('open');}
function openCallModal(){document.getElementById('callAgree').checked=false;document.getElementById('callOkBtn').classList.remove('ready');openModal('callModal');}
function toggleCallBtn(){document.getElementById('callOkBtn').classList.toggle('ready',document.getElementById('callAgree').checked);}
function doCall(){closeModal('callModal');setTimeout(()=>alert('شماره تماس: 0912-XXX-XXXX'),300);}

document.querySelectorAll('.modal-overlay').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open');}));
window.addEventListener('load',()=>{
  loadAdsFromStorage();
  renderAds(allAds);
  removeExpiredAds();
});
</script>
</body>
</html>
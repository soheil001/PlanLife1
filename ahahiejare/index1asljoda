<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>سیلو — اجاره هر چیزی</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --teal:#00897b;--teal-mid:#00695c;--teal-deep:#004d40;--teal-glow:rgba(0,137,123,0.18);
  --accent:#ff6d00;--bg-start:#0a1628;--bg-end:#0d2137;--text:#f0f4f8;
  --text-muted:rgba(240,244,248,0.55);--text-dim:rgba(240,244,248,0.35);
  --glass:rgba(255,255,255,0.07);--glass-mid:rgba(255,255,255,0.11);
  --glass-hover:rgba(255,255,255,0.15);--border:rgba(255,255,255,0.1);
  --border-mid:rgba(255,255,255,0.16);--shadow-glass:0 8px 32px rgba(0,0,0,0.35);
  --shadow-card:0 4px 24px rgba(0,0,0,0.28);--shadow-sm:0 2px 12px rgba(0,0,0,0.22);
  --radius-lg:18px;--radius-md:12px;--radius-sm:8px;--font:'Vazirmatn',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:var(--font);background:linear-gradient(135deg,var(--bg-start) 0%,var(--bg-end) 60%,#0b1d2e 100%);min-height:100vh;color:var(--text);overflow-x:hidden;}
body::before,body::after{content:'';position:fixed;border-radius:50%;pointer-events:none;z-index:0;}
body::before{width:600px;height:600px;background:radial-gradient(circle,rgba(0,137,123,0.12) 0%,transparent 70%);top:-150px;right:-150px;}
body::after{width:500px;height:500px;background:radial-gradient(circle,rgba(255,109,0,0.07) 0%,transparent 70%);bottom:-100px;left:-100px;}

header{position:sticky;top:0;z-index:200;height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:rgba(10,22,40,0.72);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);border-bottom:1px solid var(--border);box-shadow:0 2px 20px rgba(0,0,0,0.4);}
.logo{display:flex;align-items:center;cursor:pointer;user-select:none;transition:opacity .2s;text-decoration:none;}
.logo img{height:40px;object-fit:contain;}
.logo:hover{opacity:.75;}
.header-search{flex:1;max-width:440px;margin:0 24px;position:relative;}
.header-search input{width:100%;padding:10px 44px 10px 16px;background:var(--glass);border:1px solid var(--border-mid);border-radius:40px;color:var(--text);font-family:var(--font);font-size:14px;outline:none;backdrop-filter:blur(8px);transition:all .25s;}
.header-search input::placeholder{color:var(--text-dim);}
.header-search input:focus{background:var(--glass-mid);border-color:var(--teal);box-shadow:0 0 0 3px var(--teal-glow);}
.search-icon{position:absolute;right:14px;top:50%;transform:translateY(-50%);color:var(--text-dim);pointer-events:none;}
.header-actions{display:flex;gap:10px;align-items:center;}
.btn-login-header{background:var(--glass);color:var(--text);border:1px solid var(--border-mid);padding:9px 16px;border-radius:40px;font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;white-space:nowrap;display:inline-flex;align-items:center;gap:6px;}
.btn-login-header:hover{background:var(--glass-mid);}
.btn-post{background:linear-gradient(135deg,var(--teal),var(--teal-mid));color:white;border:none;padding:9px 20px;border-radius:40px;font-family:var(--font);font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 4px 16px rgba(0,137,123,0.35);transition:all .2s;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;}
.btn-post:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,137,123,0.45);}
.user-menu-wrap{position:relative;}
.user-avatar-btn{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--teal-mid));border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-family:var(--font);font-size:14px;font-weight:700;color:white;transition:.2s;}
.user-avatar-btn:hover{box-shadow:0 0 0 3px var(--teal-glow);}
.user-dropdown{display:none;position:absolute;top:48px;left:0;background:rgba(13,33,55,0.96);backdrop-filter:blur(24px);border:1px solid var(--border-mid);border-radius:var(--radius-md);min-width:180px;box-shadow:0 12px 40px rgba(0,0,0,.5);overflow:hidden;z-index:300;}
.user-dropdown.open{display:block;}
.user-dropdown a,.user-dropdown button{display:flex;align-items:center;gap:10px;padding:12px 16px;font-family:var(--font);font-size:13px;font-weight:500;color:var(--text-muted);background:none;border:none;width:100%;text-align:right;cursor:pointer;text-decoration:none;transition:.15s;}
.user-dropdown a:hover,.user-dropdown button:hover{background:var(--glass);color:var(--text);}
.user-dropdown .dd-name{padding:14px 16px 10px;font-size:12px;color:var(--text-dim);border-bottom:1px solid var(--border);}
.user-dropdown .dd-logout{color:rgba(255,100,100,.7);border-top:1px solid var(--border);}
.user-dropdown .dd-logout:hover{color:#ff6b6b;background:rgba(255,100,100,.07);}

.main-wrap{max-width:1240px;margin:0 auto;padding:28px 20px;display:flex;gap:22px;position:relative;z-index:1;}
.sidebar{width:268px;flex-shrink:0;}
.filter-box{background:var(--glass);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--border);border-radius:var(--radius-lg);padding:18px;margin-bottom:16px;box-shadow:var(--shadow-glass);}
.filter-title{font-size:12px;font-weight:700;color:var(--teal);text-transform:uppercase;letter-spacing:1.2px;margin-bottom:14px;}
.cat-group{margin-bottom:2px;}
.cat-group-header{display:flex;align-items:center;gap:8px;padding:9px 4px;cursor:pointer;font-size:13px;font-weight:600;color:var(--text-muted);border-bottom:1px solid rgba(255,255,255,0.05);transition:all .18s;user-select:none;}
.cat-group-header:hover{color:var(--text);}
.cat-group-header.active{color:var(--teal);}
.cg-dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,0.2);flex-shrink:0;transition:.2s;}
.cat-group-header.active .cg-dot{background:var(--teal);box-shadow:0 0 8px var(--teal);}
.cg-arrow{margin-right:auto;font-size:10px;color:var(--text-dim);transition:transform .22s;}
.cat-group-header.open .cg-arrow{transform:rotate(90deg);}
.cg-count{background:var(--glass-mid);border:1px solid var(--border);color:var(--text-muted);font-size:11px;padding:2px 7px;border-radius:20px;font-weight:600;}
.cat-group-header.active .cg-count{color:var(--teal);border-color:var(--teal);}
.cat-sub-list{display:none;padding:4px 0 6px 16px;}
.cat-sub-list.open{display:block;}
.cat-sub-item{display:flex;align-items:center;gap:8px;padding:7px 8px;font-size:12px;color:var(--text-dim);cursor:pointer;border-radius:6px;transition:.15s;}
.cat-sub-item:hover{background:rgba(255,255,255,.05);color:var(--text-muted);}
.cat-sub-item.active{color:var(--teal);background:rgba(0,137,123,.08);}
.cat-sub-item::before{content:'—';font-size:10px;color:rgba(255,255,255,.2);flex-shrink:0;}
.city-select,.sort-select{width:100%;padding:9px 12px;background:var(--glass);border:1px solid var(--border);border-radius:var(--radius-sm);font-family:var(--font);font-size:13px;color:var(--text);outline:none;cursor:pointer;appearance:none;-webkit-appearance:none;transition:.2s;}
.sort-select{width:auto;}
.city-select:focus,.sort-select:focus{border-color:var(--teal);}
.city-select option,.sort-select option{background:#0d2137;color:var(--text);}
.price-row{display:flex;gap:8px;}
.price-row input{flex:1;padding:9px 10px;background:var(--glass);border:1px solid var(--border);border-radius:var(--radius-sm);font-family:var(--font);font-size:12px;color:var(--text);outline:none;text-align:center;transition:.2s;}
.price-row input::placeholder{color:var(--text-dim);}
.price-row input:focus{border-color:var(--teal);}
.btn-filter{width:100%;margin-top:10px;background:linear-gradient(135deg,var(--teal),var(--teal-mid));color:white;border:none;padding:10px;border-radius:var(--radius-sm);font-family:var(--font);font-size:13px;font-weight:700;cursor:pointer;transition:.2s;box-shadow:0 4px 14px rgba(0,137,123,.3);}
.btn-filter:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(0,137,123,.4);}
.content{flex:1;min-width:0;}
.categories{background:var(--glass);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px 22px;margin-bottom:20px;box-shadow:var(--shadow-glass);}
.cat-section-title{font-size:13px;font-weight:700;color:var(--text-muted);letter-spacing:.8px;text-transform:uppercase;margin-bottom:16px;}
.cat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;}
.cat-btn{display:flex;flex-direction:column;align-items:center;gap:6px;padding:14px 8px;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:var(--radius-md);cursor:pointer;font-family:var(--font);font-size:11px;font-weight:500;color:var(--text-muted);transition:all .22s;text-align:center;}
.cat-btn:hover{background:var(--glass-mid);color:var(--text);border-color:var(--border-mid);transform:translateY(-2px);}
.cat-btn.active{background:rgba(0,137,123,.15);border-color:var(--teal);color:var(--teal);}
.cat-icon-box{width:38px;height:38px;border-radius:10px;background:var(--glass);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;transition:.22s;}
.cat-btn.active .cat-icon-box{background:rgba(0,137,123,.2);border-color:var(--teal);}
.sort-bar{background:var(--glass);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border:1px solid var(--border);border-radius:var(--radius-md);padding:12px 18px;display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;font-size:13px;box-shadow:var(--shadow-sm);}
.sort-bar span{color:var(--text-muted);}
.sort-bar strong{color:var(--teal);}
.ads-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px;}

/* کارت آگهی */
.ad-card{background:var(--glass);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;cursor:pointer;transition:all .25s;box-shadow:var(--shadow-card);position:relative;}
.ad-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,.45);border-color:var(--border-mid);background:var(--glass-mid);}
.ad-img-wrap{width:100%;height:164px;background:linear-gradient(135deg,rgba(0,137,123,0.12),rgba(0,77,64,0.2));border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;}
.ad-img-wrap img{width:100%;height:100%;object-fit:cover;}
.ad-badge{position:absolute;top:10px;right:10px;background:linear-gradient(135deg,var(--accent),#e65100);color:white;font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;letter-spacing:.5px;box-shadow:0 2px 8px rgba(255,109,0,.4);}
.ad-body{padding:14px 16px;}
.ad-title{font-size:14px;font-weight:600;line-height:1.45;margin-bottom:8px;color:var(--text);}
.ad-location{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted);margin-bottom:10px;}
.ad-location-dot{width:5px;height:5px;border-radius:50%;background:var(--teal);}
.ad-footer{display:flex;justify-content:space-between;align-items:flex-end;border-top:1px solid rgba(255,255,255,.06);padding-top:10px;}
.ad-price{font-size:16px;font-weight:700;color:var(--text);}
.ad-price small{font-size:11px;font-weight:400;color:var(--text-muted);display:block;}
.ad-date{font-size:11px;color:var(--text-dim);}

/* حالت خالی */
.empty-ads{text-align:center;padding:60px 20px;color:var(--text-dim);grid-column:1/-1;}
.empty-ads .ea-icon{font-size:48px;margin-bottom:12px;}
.empty-ads p{font-size:14px;}

/* DETAIL */
.detail-wrap{max-width:960px;margin:0 auto;padding:28px 20px;position:relative;z-index:1;}
.back-btn{display:inline-flex;align-items:center;gap:8px;color:var(--teal);font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;border:none;background:none;padding:8px 0;margin-bottom:20px;transition:.2s;}
.back-btn:hover{opacity:.75;}
.detail-grid{display:grid;grid-template-columns:1fr 310px;gap:22px;}
.detail-main{background:var(--glass);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-glass);}
.detail-carousel{position:relative;overflow:hidden;}
.carousel-track{display:flex;transition:transform .4s cubic-bezier(.4,0,.2,1);}
.carousel-slide{flex-shrink:0;width:100%;height:300px;background:linear-gradient(135deg,rgba(0,137,123,.14),rgba(0,77,64,.22));display:flex;align-items:center;justify-content:center;}
.carousel-slide img{width:100%;height:100%;object-fit:cover;}
.carousel-dots{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:6px;z-index:5;}
.dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.3);cursor:pointer;transition:.2s;}
.dot.active{background:var(--teal);width:18px;border-radius:3px;}
.carousel-btn{position:absolute;top:50%;transform:translateY(-50%);width:36px;height:36px;background:rgba(0,0,0,.5);backdrop-filter:blur(8px);border:1px solid var(--border);border-radius:50%;color:white;font-size:20px;cursor:pointer;transition:.2s;display:flex;align-items:center;justify-content:center;z-index:5;line-height:1;}
.carousel-btn:hover{background:rgba(0,137,123,.5);}
.carousel-btn.prev{right:12px;}
.carousel-btn.next{left:12px;}
.detail-info{padding:22px;}
.detail-info h1{font-size:20px;font-weight:700;margin-bottom:12px;line-height:1.4;}
.detail-tags{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px;}
.detail-tag{display:flex;align-items:center;gap:6px;background:var(--glass-mid);border:1px solid var(--border);border-radius:20px;padding:5px 12px;font-size:12px;color:var(--text-muted);}
.detail-tag-dot{width:5px;height:5px;border-radius:50%;background:var(--teal);}
.detail-desc{font-size:14px;line-height:1.9;color:var(--text-muted);border-top:1px solid rgba(255,255,255,.07);padding-top:18px;}
.detail-sidebar{display:flex;flex-direction:column;gap:16px;}
.contact-box{background:var(--glass);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--border);border-radius:var(--radius-lg);padding:22px;box-shadow:var(--shadow-glass);}
.price-big{font-size:26px;font-weight:900;color:var(--text);}
.price-unit{font-size:12px;color:var(--text-dim);margin-bottom:18px;letter-spacing:.3px;}
.price-toman{color:var(--teal);font-size:14px;font-weight:600;}
.btn-call-detail{width:100%;border-radius:var(--radius-md);font-family:var(--font);font-size:14px;font-weight:700;cursor:pointer;transition:all .22s;padding:13px;background:linear-gradient(135deg,var(--teal),var(--teal-mid));color:white;border:none;margin-bottom:10px;box-shadow:0 4px 16px rgba(0,137,123,.35);}
.btn-call-detail:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,137,123,.45);}
.owner-box{background:var(--glass);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--border);border-radius:var(--radius-lg);padding:18px;box-shadow:var(--shadow-glass);}
.owner-label{font-size:11px;font-weight:700;color:var(--text-dim);letter-spacing:1px;text-transform:uppercase;margin-bottom:14px;}
.owner-info{display:flex;align-items:center;gap:12px;}
.owner-avatar{width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,rgba(0,137,123,.25),rgba(0,77,64,.35));border:1px solid var(--border-mid);display:flex;align-items:center;justify-content:center;}
.owner-name{font-size:14px;font-weight:600;}
.owner-since{font-size:12px;color:var(--text-dim);margin-top:2px;}

/* MODALS */
.modal-overlay{display:none;position:fixed;inset:0;z-index:999;background:rgba(0,0,0,.65);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);align-items:center;justify-content:center;padding:20px;}
.modal-overlay.open{display:flex;}
.modal-box{background:rgba(13,33,55,0.82);backdrop-filter:blur(32px);-webkit-backdrop-filter:blur(32px);border:1px solid var(--border-mid);border-radius:var(--radius-lg);padding:30px;max-width:480px;width:100%;box-shadow:0 24px 60px rgba(0,0,0,.6);animation:modalIn .3s cubic-bezier(.34,1.56,.64,1) both;}
@keyframes modalIn{from{opacity:0;transform:scale(.9) translateY(20px)}to{opacity:1;transform:scale(1) translateY(0)}}
.modal-logo{text-align:center;margin-bottom:6px;}
.modal-logo img{height:36px;object-fit:contain;}
.modal-tagline{font-size:12px;color:var(--text-dim);margin-bottom:22px;text-align:center;}
.modal-title{font-size:16px;font-weight:700;margin-bottom:14px;color:var(--text);}
.modal-body{font-size:13px;line-height:1.85;color:var(--text-muted);background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-sm);padding:14px 16px;margin-bottom:20px;}
.modal-body strong{color:var(--text);}
.modal-check{display:flex;align-items:flex-start;gap:12px;margin-bottom:22px;cursor:pointer;}
.modal-check input[type="checkbox"]{width:18px;height:18px;margin-top:1px;accent-color:var(--teal);cursor:pointer;flex-shrink:0;}
.modal-check span{font-size:13px;color:var(--text-muted);line-height:1.6;}
.modal-actions{display:flex;gap:10px;}
.btn-modal-cancel{flex:1;padding:12px;background:transparent;border:1.5px solid rgba(255,255,255,.15);border-radius:var(--radius-md);color:var(--text-muted);font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;transition:.2s;}
.btn-modal-cancel:hover{border-color:rgba(255,255,255,.3);color:var(--text);}
.btn-modal-ok{flex:2;padding:12px;background:linear-gradient(135deg,var(--teal),var(--teal-mid));border:none;border-radius:var(--radius-md);color:white;font-family:var(--font);font-size:13px;font-weight:700;cursor:pointer;box-shadow:0 4px 16px rgba(0,137,123,.35);transition:.2s;opacity:.5;pointer-events:none;}
.btn-modal-ok.ready{opacity:1;pointer-events:all;}
.btn-modal-ok.ready:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,137,123,.45);}

.phone-reveal-box{display:none;background:rgba(0,137,123,.12);border:1px solid var(--teal);border-radius:var(--radius-md);padding:16px;text-align:center;margin-top:14px;}
.phone-reveal-box.show{display:block;}
.phone-number{font-size:22px;font-weight:800;color:var(--text);letter-spacing:2px;margin-bottom:12px;}
.btn-call-now{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--teal),var(--teal-mid));color:white;border:none;padding:12px 28px;border-radius:40px;font-family:var(--font);font-size:14px;font-weight:700;cursor:pointer;text-decoration:none;box-shadow:0 4px 16px rgba(0,137,123,.4);transition:.2s;}
.btn-call-now:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(0,137,123,.5);}

/* LOGIN MODAL */
.login-box{background:rgba(13,33,55,0.82);backdrop-filter:blur(32px);-webkit-backdrop-filter:blur(32px);border:1px solid var(--border-mid);border-radius:var(--radius-lg);padding:36px 30px;max-width:400px;width:100%;box-shadow:0 24px 60px rgba(0,0,0,.6);animation:modalIn .3s cubic-bezier(.34,1.56,.64,1) both;}
.login-logo{text-align:center;margin-bottom:6px;}
.login-logo img{height:42px;object-fit:contain;}
.login-subtitle{text-align:center;font-size:12px;color:var(--text-dim);margin-bottom:28px;}
.login-tabs{display:flex;gap:4px;background:rgba(255,255,255,.05);border-radius:40px;padding:4px;margin-bottom:24px;}
.login-tab{flex:1;padding:9px;border:none;border-radius:36px;font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;background:transparent;color:var(--text-muted);transition:.22s;}
.login-tab.active{background:var(--teal);color:white;box-shadow:0 2px 10px rgba(0,137,123,.4);}
.login-input-group{margin-bottom:14px;}
.login-input-group label{display:block;font-size:12px;font-weight:600;color:var(--text-muted);margin-bottom:7px;}
.login-input-group input{width:100%;padding:12px 14px;background:rgba(255,255,255,.07);border:1px solid var(--border-mid);border-radius:var(--radius-sm);font-family:var(--font);font-size:14px;color:var(--text);outline:none;transition:.22s;}
.login-input-group input::placeholder{color:var(--text-dim);}
.login-input-group input:focus{border-color:var(--teal);background:rgba(0,137,123,.07);box-shadow:0 0 0 3px var(--teal-glow);}
.btn-login-submit{width:100%;margin-top:6px;padding:13px;background:linear-gradient(135deg,var(--teal),var(--teal-mid));border:none;border-radius:var(--radius-md);font-family:var(--font);font-size:15px;font-weight:700;color:white;cursor:pointer;box-shadow:0 4px 18px rgba(0,137,123,.35);transition:.22s;}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>پنل سیلو</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --teal:#00897b;--teal-mid:#00695c;--accent:#ff6d00;
  --bg:#0a1628;--bg2:#0d2137;--text:#f0f4f8;
  --muted:rgba(240,244,248,0.55);--dim:rgba(240,244,248,0.32);
  --glass:rgba(255,255,255,0.06);--glass2:rgba(255,255,255,0.10);
  --border:rgba(255,255,255,0.09);--border2:rgba(255,255,255,0.15);
  --r:14px;--font:'Vazirmatn',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:var(--font);background:linear-gradient(135deg,var(--bg) 0%,var(--bg2) 60%,#0b1d2e 100%);min-height:100vh;color:var(--text);}

/* Login */
.login-screen{position:fixed;inset:0;z-index:999;background:radial-gradient(ellipse at 30% 20%,rgba(0,137,123,.18) 0%,transparent 60%),linear-gradient(135deg,#060e1c 0%,#0d2137 100%);display:flex;align-items:center;justify-content:center;padding:20px;}
.login-card{background:rgba(13,33,55,.92);border:1px solid var(--border2);border-radius:20px;padding:44px 40px;max-width:400px;width:100%;box-shadow:0 32px 80px rgba(0,0,0,.7);text-align:center;}
.login-card img{height:42px;margin-bottom:8px;}
.login-title{font-size:20px;font-weight:800;margin-bottom:4px;}
.login-sub{font-size:12px;color:var(--dim);margin-bottom:28px;}
.login-field{width:100%;padding:13px 16px;background:rgba(255,255,255,.06);border:1px solid var(--border2);border-radius:10px;font-family:var(--font);font-size:14px;color:var(--text);outline:none;margin-bottom:12px;transition:.2s;}
.login-field:focus{border-color:var(--teal);background:rgba(0,137,123,.07);}
.btn-enter{width:100%;padding:14px;background:linear-gradient(135deg,var(--teal),var(--teal-mid));border:none;border-radius:10px;color:white;font-family:var(--font);font-size:15px;font-weight:800;cursor:pointer;letter-spacing:.3px;margin-top:4px;transition:.2s;}
.err{font-size:12px;color:#ff6b6b;margin-top:10px;display:none;}
.err.on{display:block;}

/* Common */
.app-wrap{display:none;min-height:100vh;}
.app-wrap.visible{display:flex;}
header, .sidebar, .main {transition: all .3s;}

/* Admin Sidebar */
.sidebar{width:240px;flex-shrink:0;background:rgba(10,22,40,.9);border-left:1px solid var(--border);position:fixed;top:0;right:0;bottom:0;display:flex;flex-direction:column;padding:20px 0;z-index:100;overflow-y:auto;}
.sb-logo{display:flex;align-items:center;gap:10px;padding:0 20px 20px;border-bottom:1px solid var(--border);}
.sb-logo img{height:32px;}
.sb-badge{background:rgba(255,109,0,.2);border:1px solid rgba(255,109,0,.4);color:#ff9040;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700;}
.sb-item{display:flex;align-items:center;gap:10px;padding:11px 20px;font-size:13px;font-weight:600;color:var(--muted);cursor:pointer;transition:.15s;border-right:3px solid transparent;}
.sb-item:hover{color:var(--text);background:rgba(255,255,255,.04);}
.sb-item.active{color:var(--teal);background:rgba(0,137,123,.08);border-right-color:var(--teal);}
.sb-bottom{padding:16px 20px;border-top:1px solid var(--border);}
.btn-logout{width:100%;padding:10px;background:rgba(255,100,100,.08);border:1px solid rgba(255,100,100,.2);border-radius:10px;color:rgba(255,120,120,.8);font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;transition:.2s;}

/* User Header */
.user-header{position:sticky;top:0;z-index:200;height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:rgba(10,22,40,0.85);backdrop-filter:blur(24px);border-bottom:1px solid var(--border);}

/* Main Content */
.main{margin-right:240px;flex:1;padding:28px;overflow-y:auto;}

/* User Panel */
.panel-wrap{max-width:1000px;margin:0 auto;padding:20px;}
.panel-tabs{display:flex;gap:4px;background:var(--glass);border:1px solid var(--border);border-radius:40px;padding:4px;margin-bottom:22px;width:fit-content;}
.panel-tab{padding:9px 20px;border:none;border-radius:36px;font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;background:transparent;color:var(--muted);}
.panel-tab.active{background:var(--teal);color:white;}
.my-ads-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;}
.dash-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:28px;}
.dash-card{background:var(--glass);border:1px solid var(--border);border-radius:var(--r);padding:22px 24px;}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:rgba(13,33,55,.97);border:1px solid var(--teal);color:var(--teal);padding:11px 22px;border-radius:40px;font-size:13px;font-weight:600;z-index:9999;opacity:0;transition:opacity .3s;}
.toast.on{opacity:1;}
</style>
</head>
<body>

<!-- LOGIN -->
<div class="login-screen" id="loginScreen">
  <div class="login-card">
    <img src="https://res.cloudinary.com/dshielkdt/image/upload/q_auto/f_auto/v1781018687/_ir_puvab6.png" alt="سیلو">
    <div class="login-title">ورود به پنل سیلو</div>
    <div class="login-sub">ادمین یا کاربر</div>
    <input class="login-field" type="text" id="loginUser" placeholder="نام کاربری / شماره موبایل">
    <input class="login-field" type="password" id="loginPass" placeholder="رمز عبور">
    <div class="err" id="loginErr">نام کاربری یا رمز عبور اشتباه است</div>
    <button class="btn-enter" onclick="doLogin()">ورود</button>
  </div>
</div>

<!-- APP CONTAINER -->
<div class="app-wrap" id="appWrap">

  <!-- ADMIN SIDEBAR -->
  <nav class="sidebar" id="adminSidebar">
    <div class="sb-logo">
      <img src="https://res.cloudinary.com/dshielkdt/image/upload/q_auto/f_auto/v1781018687/_ir_puvab6.png" alt="">
      <span class="sb-badge">ادمین</span>
    </div>
    <div class="sb-nav">
      <div class="sb-item active" onclick="goSection('dash',this)">داشبورد</div>
      <div class="sb-item" onclick="goSection('pending',this)">در انتظار بررسی <span class="sb-cnt" id="cntPendingBadge">0</span></div>
      <div class="sb-item" onclick="goSection('banned',this)">کلمات ممنوع <span class="sb-cnt" id="cntBannedBadge">0</span></div>
      <div class="sb-item" onclick="goSection('approved',this)">تأیید شده <span class="sb-cnt" id="cntApprovedBadge">0</span></div>
      <div class="sb-item" onclick="goSection('rejected',this)">رد شده</div>
      <div class="sb-item" onclick="goSection('users',this)">کاربران</div>
    </div>
    <div class="sb-bottom">
      <button class="btn-logout" onclick="doLogout()">خروج</button>
    </div>
  </nav>

  <!-- USER HEADER -->
  <header class="user-header" id="userHeader" style="display:none;">
    <a href="index.html" class="logo">
      <img src="https://res.cloudinary.com/dshielkdt/image/upload/q_auto/f_auto/v1781018687/_ir_puvab6.png" alt="سیلو">
    </a>
    <div style="display:flex;gap:12px;align-items:center;">
      <a href="index.html" class="btn-back">صفحه اصلی</a>
      <button class="btn-logout" onclick="doLogout()">خروج</button>
    </div>
  </header>

  <div class="main" id="mainContent">
    <!-- ADMIN CONTENT -->
    <div id="adminContent">
      <div class="section active" id="sec-dash">
        <h2>داشبورد ادمین</h2>
        <div class="dash-grid">
          <div class="dash-card">تعداد آگهی‌های در انتظار: <strong id="dash-pending">0</strong></div>
          <div class="dash-card">آگهی‌های تأیید شده: <strong id="dash-approved">0</strong></div>
        </div>
      </div>

      <div class="section" id="sec-pending">
        <h2>آگهی‌های در انتظار بررسی</h2>
        <div id="pendingList"></div>
      </div>

      <div class="section" id="sec-approved">
        <h2>آگهی‌های تأیید شده</h2>
        <div id="approvedList"></div>
      </div>

      <!-- بقیه بخش‌ها رو بعداً کامل می‌کنیم -->
    </div>

    <!-- USER CONTENT -->
    <div id="userContent" style="display:none;">
      <div class="panel-wrap">
        <h2>پنل کاربری</h2>
        <p>آگهی‌های من اینجا نمایش داده می‌شود (بعداً کامل می‌کنیم)</p>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// تنظیمات
const ADMIN_USERNAME = '00216542000';
const ADMIN_PASS     = '29332933';

const $ = id => document.getElementById(id);

// Helper functions
function getPending() { 
  try { return JSON.parse(localStorage.getItem('siloPendingAds') || '[]'); } 
  catch { return []; } 
}
function savePending(a) { localStorage.setItem('siloPendingAds', JSON.stringify(a)); }
function getAllAds() { 
  try { return JSON.parse(localStorage.getItem('siloAds') || '[]'); } 
  catch { return []; } 
}
function saveAllAds(a) { localStorage.setItem('siloAds', JSON.stringify(a)); }

// Login
function doLogin() {
  const input = ($('loginUser').value || '').trim();
  const pass  = $('loginPass').value;

  const isAdmin = input === ADMIN_USERNAME && pass === ADMIN_PASS;

  if (isAdmin) {
    localStorage.setItem('siloMode', 'admin');
    showAdminPanel();
  } else {
    $('loginErr').classList.add('on');
    return;
  }

  $('loginScreen').style.display = 'none';
  $('appWrap').classList.add('visible');
}

function showAdminPanel() {
  $('adminSidebar').style.display = 'flex';
  $('userHeader').style.display = 'none';
  $('adminContent').style.display = 'block';
  $('userContent').style.display = 'none';
  loadAdminDashboard();
}

function doLogout() {
  localStorage.removeItem('siloMode');
  $('appWrap').classList.remove('visible');
  $('loginScreen').style.display = 'flex';
  $('loginUser').value = '';
  $('loginPass').value = '';
  $('loginErr').classList.remove('on');
}

function goSection(name, el) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.sb-item').forEach(s => s.classList.remove('active'));
  $(`sec-${name}`).classList.add('active');
  el.classList.add('active');
}

function loadAdminDashboard() {
  const pending = getPending();
  $('dash-pending').textContent = pending.length;
  // بعداً بقیه آمارها رو اضافه می‌کنیم
}

// Init
window.addEventListener('load', () => {
  const mode = localStorage.getItem('siloMode');
  if (mode === 'admin') {
    $('loginScreen').style.display = 'none';
    $('appWrap').classList.add('visible');
    showAdminPanel();
  }
});
</script>
</body>
</html>

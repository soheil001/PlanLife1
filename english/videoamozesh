    <div class="plan-row"><div class="plan-name">اشتراک ۶ ماهه</div><div class="plan-prices"><div class="plan-old">۱,۶۸۰,۰۰۰</div><div class="plan-new">۱,۱۹۰,۰۰۰ تومان</div></div></div>
    <div class="plan-row"><div class="plan-name">اشتراک سالانه</div><div class="plan-prices"><div class="plan-old">۳,۳۶۰,۰۰۰</div><div class="plan-new">۲,۵۸۰,۰۰۰ تومان</div></div></div>
    <div class="price-subscribe-btns">
      <a class="btn-sub telegram" href="https://t.me/planlifeir" target="_blank" rel="noopener">خرید از تلگرام</a>
      <a class="btn-sub bale" href="https://ble.ir/planlifeir" target="_blank" rel="noopener">خرید از بله</a>
      <a class="btn-sub whatsapp" href="https://wa.me/00905437333582" target="_blank" rel="noopener">خرید از واتس‌اپ</a>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ============ Supabase + session (same as English page) ============ */
const SUPABASE_URL='https://hjzzvzxhrqovvducnxha.supabase.co';
const SUPABASE_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhqenp2enhocnFvdnZkdWNueGhhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE5NDY0MTksImV4cCI6MjA5NzUyMjQxOX0.XfFimXnkKHFBlYUE-E7daaBNjPJZV-D21UfCL_1SeoQ';
async function sbGet(table,filter){
  const r=await fetch(`${SUPABASE_URL}/rest/v1/${table}?${filter}&limit=1`,{headers:{apikey:SUPABASE_KEY,Authorization:'Bearer '+SUPABASE_KEY}});
  return r.json();
}
async function sbInsert(table,body){
  const r=await fetch(`${SUPABASE_URL}/rest/v1/${table}`,{method:'POST',
    headers:{apikey:SUPABASE_KEY,Authorization:'Bearer '+SUPABASE_KEY,'Content-Type':'application/json',Prefer:'return=minimal'},body:JSON.stringify(body)});
  return r.ok;
}
const SESSION_KEY='lingua_session_v1';
function getSession(){try{return JSON.parse(localStorage.getItem(SESSION_KEY)||'null');}catch(e){return null;}}
function setSession(d){try{localStorage.setItem(SESSION_KEY,JSON.stringify(d));}catch(e){}}
function isLoggedIn(){const s=getSession();return !!(s&&s.phone&&s.verified);}
function showToast(m,d=2800){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),d);}

/* ============ Videos — files live in /video/graphic/ ============ */
const BASE='http://fs3.centraldnserver.com/~planlife/pics/english/video/graphic/';
/* برای اضافه کردن ویدیو: فایل N.mp4 را در همین پوشه آپلود کنید و عدد N را به این لیست اضافه کنید */
const VIDEO_IDS=[1,2,3,4,5,6,7];
/* عنوان اختیاری برای هر ویدیو: TITLES={3:'عنوان ویدیوی ۳'} */
const TITLES={};
/* کاور اختیاری: اگر برای ویدیویی فایل N.jpg هم گذاشتید، عدد N را اینجا بنویسید. بقیه از فریم اول خود ویدیو کاور می‌گیرند */
const JPG_COVERS=[];
const videos=VIDEO_IDS.map(n=>({
  src:`${BASE}${n}.mp4`,
  cover:JPG_COVERS.includes(n)?`${BASE}${n}.jpg`:'',
  title:TITLES[n]||''
}));

/* ============ Access ============ */
let unlocked=false;
function setAccess(on){
  unlocked=on;
  const ic=document.getElementById('loginIconBtn');
  if(ic){
    ic.classList.toggle('logged-in',on);
    ic.setAttribute('aria-label',on?'حساب کاربری':'ورود');
  }
  document.querySelectorAll('.item').forEach(el=>{
    el.classList.toggle('open',on);
    el.querySelector('.lock').textContent=on?'✓ فعال':'🔒 قفل';
  });
}
async function verifySubscription(){
  const s=getSession();
  if(!s||!s.phone||!s.verified){setAccess(false);return false;}
  try{
    const subs=await sbGet('subscriptions',`phone=eq.${encodeURIComponent(s.phone)}&is_active=eq.true`);
    const ok=Array.isArray(subs)&&subs.length>0;
    if(!ok)try{localStorage.removeItem(SESSION_KEY);}catch(e){}
    setAccess(ok);return ok;
  }catch(e){setAccess(false);return false;}
}

/* آیکن ورود: اگر وارد نشده باشد پاپ‌آپ ورود، اگر وارد شده باشد خروج از حساب */
function onLoginIconClick(){
  if(isLoggedIn()){
    if(confirm('می‌خواهید از حساب خود خارج شوید؟')){
      try{localStorage.removeItem(SESSION_KEY);}catch(e){}
      location.reload();
    }
  }else{
    openLoginPopup(null);
  }
}

/* ============ Grid ============ */
const grid=document.getElementById('grid');
grid.innerHTML=videos.map((v,i)=>`
  <div class="item" data-i="${i}">
    ${v.cover
      ?`<img src="${v.cover}" alt="ویدیو ${i+1}" width="180" height="320" decoding="async" fetchpriority="high">`
      :`<video src="${v.src}#t=0.001" preload="metadata" muted playsinline webkit-playsinline disablepictureinpicture tabindex="-1"></video>`}
    <div class="lock">🔒 قفل</div>
    <div class="play"><svg width="11" height="11" viewBox="0 0 24 24" fill="#fff"><path d="M7 4l13 8-13 8z"/></svg></div>
  </div>`).join('');

grid.addEventListener('click',e=>{
  const it=e.target.closest('.item');if(!it)return;
  const i=+it.dataset.i;
  if(!isLoggedIn()){openLoginPopup(()=>openFeed(i));return;}
  openFeed(i);                       // باز شدن فوری؛ بررسی اشتراک در پس‌زمینه
  verifySubscription().then(ok=>{
    if(!ok){closeFeed();openLoginPopup(()=>openFeed(i));}
  });
});

/* ============ Feed (videos are only loaded after access is confirmed) ============ */
const feed=document.getElementById('feed');
const feedModal=document.getElementById('feedModal');
let slides=[],io=null;

function loadSlide(s,mode){
  if(!s||s.dataset.loaded==='full')return;
  const v=s.querySelector('video');
  if(mode==='full'||!v.src){
    v.preload=mode==='full'?'auto':'metadata';
    if(!v.src){v.src=videos[+s.dataset.i].src+'#t=0.001';v.load();}
    if(mode==='full')s.dataset.loaded='full';
  }
}
function buildFeed(){
  feed.innerHTML=videos.map((v,i)=>`
    <div class="slide" data-i="${i}">
      <video playsinline webkit-playsinline loop preload="metadata"></video>
      <div class="spin"></div>
      <div class="shade"></div>
      ${v.title?`<div class="cap">${v.title}</div>`:''}
    </div>`).join('');
  slides=[...feed.querySelectorAll('.slide')];
  slides.forEach(s=>{
    const v=s.querySelector('video'),sp=s.querySelector('.spin');
    ['playing','canplay','loadeddata'].forEach(ev=>v.addEventListener(ev,()=>sp.style.display='none'));
    ['waiting','loadstart'].forEach(ev=>v.addEventListener(ev,()=>sp.style.display=''));
    s.addEventListener('click',()=>v.paused?v.play().catch(()=>{}):v.pause());
  });
  if(io)io.disconnect();
  io=new IntersectionObserver(entries=>{
    entries.forEach(en=>{
      const s=en.target,v=s.querySelector('video'),i=slides.indexOf(s);
      if(en.isIntersecting&&en.intersectionRatio>.6){
        loadSlide(s,'full');
        v.play().catch(()=>{});
        loadSlide(slides[i+1],'meta');   // پیش‌بارگذاری سبک ویدیوی بعدی
        loadSlide(slides[i-1],'meta');
      }else v.pause();
    });
  },{threshold:[0,.6,1]});
  slides.forEach(s=>io.observe(s));
}
function openFeed(i){
  buildFeed();
  feedModal.classList.add('open');
  document.body.style.overflow='hidden';
  feed.scrollTop=slides[i].offsetTop;
  loadSlide(slides[i],'full');
  slides[i].querySelector('video').play().catch(()=>{});
}
function closeFeed(){
  feedModal.classList.remove('open');
  document.body.style.overflow='';
  slides.forEach(s=>{const v=s.querySelector('video');v.pause();v.removeAttribute('src');v.load();});
  if(io)io.disconnect();
}
document.addEventListener('keydown',e=>{
  if(!feedModal.classList.contains('open'))return;
  if(e.key==='Escape')closeFeed();
  if(e.key==='ArrowDown')feed.scrollBy({top:feed.clientHeight,behavior:'smooth'});
  if(e.key==='ArrowUp')feed.scrollBy({top:-feed.clientHeight,behavior:'smooth'});
});

/* ============ Login popup ============ */
let pendingAction=null;
function openLoginPopup(a){
  pendingAction=a||null;
  document.getElementById('loginPopup').classList.add('open');
  setTimeout(()=>document.getElementById('phoneInput').focus(),400);
}
function closeLoginPopup(){document.getElementById('loginPopup').classList.remove('open');pendingAction=null;}
document.getElementById('loginPopup').addEventListener('click',function(e){if(e.target===this)closeLoginPopup();});
document.getElementById('phoneInput').addEventListener('keydown',e=>{if(e.key==='Enter')doLogin();});

async function doLogin(){
  const input=document.getElementById('phoneInput'),err=document.getElementById('phoneError'),
        btn=document.getElementById('btnLogin'),txt=document.getElementById('loginBtnText');
  err.textContent='';
  let phone=input.value.trim().replace(/\D/g,'');
  if(phone.startsWith('0'))phone=phone.slice(1);
  if(phone.length<10||phone.length>11){err.textContent='شماره موبایل معتبر نیست';return;}
  btn.disabled=true;txt.textContent='در حال بررسی...';
  try{
    const subs=await sbGet('subscriptions',`phone=eq.${phone}&is_active=eq.true`);
    if(subs&&subs.length>0){
      setSession({phone,verified:true,ts:Date.now()});
      await sbInsert('users',{phone});
      const a=pendingAction;
      closeLoginPopup();setAccess(true);
      showToast('✅ خوش آمدید! ویدیوها باز شدند');
      if(a)setTimeout(a,150);
    }else{
      await sbInsert('users',{phone});
      err.textContent='اشتراک فعال یافت نشد. لطفاً کد اشتراک تهیه کنید.';
    }
  }catch(e){err.textContent='خطا در اتصال. دوباره تلاش کنید.';}
  btn.disabled=false;txt.textContent='ورود';
}
function openPricePopup(){document.getElementById('pricePopup').classList.add('open');}
function closePricePopup(){document.getElementById('pricePopup').classList.remove('open');}
document.getElementById('pricePopup').addEventListener('click',function(e){if(e.target===this)closePricePopup();});

verifySubscription();
</script>
